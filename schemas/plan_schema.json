{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Remediation Plan Schema v0.1",
  "type": "object",
  "required": [
    "strategy",
    "generated_at",
    "order"
  ],
  "properties": {
    "strategy": {
      "type": "string",
      "enum": ["random", "severity_only", "dependency_aware"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "order": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ansible_task_ref",
          "disruption_risk",
          "touches",
          "health_checks",
          "rollback_available"
        ],
        "properties": {
          "id": { "type": "string" },
          "ansible_task_ref": { "type": "string" },
          "disruption_risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "touches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "path": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          },
          "health_checks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rollback_available": { "type": "boolean" }
        }
      }
    }
  }
}
